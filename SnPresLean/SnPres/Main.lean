/-
**Theorem 1.1** (the main theorem).

There are absolute constants `r₀`, `c₀` such that for every `n ≥ 2` the symmetric group `S_n` has a
presentation on the generators `x = (0,1)` and `y = (0,1,…,n-1)` with at most `r₀` relators and
length at most `c₀ log n`; for `n ≥ 245` one can take `r₀ = 62`.

Conventions (as in the paper): `Sym n` is `S_n` acting on `[0, n-1]` on the right
(`gh` = first `g`, then `h`); the relators are genuine power expressions (`PE.WF`), and the length
of a presentation is `|𝒜| + ∑ ℓ(E)` with `|𝒜| = 2`.  At the end we also state the result in
Mathlib's convention for `Equiv.Perm (Fin n)` (with reversed relators).
-/
import SnPres.Bounds
import Mathlib.GroupTheory.Schreier
import Mathlib.GroupTheory.FreeGroup.Reduce

namespace SnPres

open PE

/-! ### `n ≥ 245` -/

/-- the total length `|{x,y}| + ∑_{E ∈ R} ℓ(E)` of a presentation on `x, y` -/
def presLength (R : Finset (PE XY)) : ℕ := Fintype.card XY + ∑ E ∈ R, E.length

lemma card_XY : Fintype.card XY = 2 := rfl

/-- **Theorem 1.1 for `n ≥ 245`**, with explicit bounds per relator. -/
theorem main_large (n : ℕ) (hn : 245 ≤ n) :
    ∃ R : Finset (PE XY), IsPresentation (xyv n (by omega)) (R : Set (PE XY)) ∧
      (∀ E ∈ R, E.WF) ∧ R.card ≤ 62 ∧
      ∀ E ∈ R, E.length ≤ 486816 + 773576 * (Nat.log 2 n + 4) := by
  obtain ⟨p, hp, hp11, h1, h2⟩ := lemma_7_1 n hn
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨lam, mu, -, hlam, -, hmu, hpr⟩ := exists_primRoot (p := p)
  have hNN : NN p = 2 * (p * p) + 2 := rfl
  have hpp : p ≤ p * p := Nat.le_mul_of_pos_left p (by omega)
  refine ⟨(mainRels n p lam mu).toFinset, ?_, ?_, ?_, ?_⟩
  · rw [List.coe_toFinset]
    exact isPresentation_main (by omega) hpr (by omega) (by omega)
  · intro E hE
    exact mainRels_wf E (List.mem_toFinset.mp hE)
  · exact (List.toFinset_card_le _).trans mainRels_length
  · intro E hE
    exact mainRels_length_le (by omega) (by omega) (by omega) (by omega) E
      (List.mem_toFinset.mp hE)

/-- the constant `c₀` for `n ≥ 245` -/
def cLarge : ℕ := 2 + 62 * 486816 + 62 * 773576 * 5

/-- **Theorem 1.1, the case `n ≥ 245`**: at most `62` relators and length at most
`c₀ log₂ n`. -/
theorem main_large' (n : ℕ) (hn : 245 ≤ n) :
    ∃ R : Finset (PE XY), IsPresentation (xyv n (by omega)) (R : Set (PE XY)) ∧
      (∀ E ∈ R, E.WF) ∧ R.card ≤ 62 ∧ presLength R ≤ cLarge * Nat.log 2 n := by
  obtain ⟨R, hP, hW, hc, hl⟩ := main_large n hn
  refine ⟨R, hP, hW, hc, ?_⟩
  have hlog : 1 ≤ Nat.log 2 n := Nat.le_log_of_pow_le (by norm_num) (by omega)
  have hsum : ∑ E ∈ R, E.length ≤ R.card • (486816 + 773576 * (Nat.log 2 n + 4)) :=
    Finset.sum_le_card_nsmul _ _ _ hl
  rw [smul_eq_mul] at hsum
  unfold presLength cLarge
  rw [card_XY]
  have h62 : R.card * (486816 + 773576 * (Nat.log 2 n + 4)) ≤
      62 * (486816 + 773576 * (Nat.log 2 n + 4)) := Nat.mul_le_mul_right _ hc
  nlinarith

/-! ### Small `n`: every `S_n` is finitely presented on `x, y` (Schreier's lemma) -/

/-- a word as a power expression -/
def wordPE {α : Type*} : List (α × Bool) → PE α
  | [] => one
  | (a, b) :: l => mul (if b then gen a else inv (gen a)) (wordPE l)

lemma toFreeGroup_wordPE {α : Type*} (l : List (α × Bool)) :
    (wordPE l).toFreeGroup = FreeGroup.mk l := by
  induction l with
  | nil => rw [FreeGroup.one_eq_mk.symm]; rfl
  | cons x l ih =>
    obtain ⟨a, b⟩ := x
    simp only [wordPE, toFreeGroup, eval_mul] at ih ⊢
    rw [ih, show ((a, b) :: l) = [(a, b)] ++ l from rfl, ← FreeGroup.mul_mk]
    congr 1
    cases b
    · simp only [Bool.false_eq_true, if_false, eval_inv, eval_gen]
      rw [show FreeGroup.of a = FreeGroup.mk [(a, true)] from rfl, FreeGroup.inv_mk]
      rfl
    · simp only [if_true, eval_gen]; rfl

/-- Every finite group generated by `x, y` (here `S_n`) has a finite presentation on `x, y`
(Schreier's lemma: the kernel of `F(x,y) → S_n` has finite index, hence is finitely generated). -/
theorem exists_finite_presentation (n : ℕ) (hn : 2 ≤ n) :
    ∃ R : Finset (PE XY), IsPresentation (xyv n (by omega)) (R : Set (PE XY)) ∧
      ∀ E ∈ R, E.WF := by
  classical
  set φ : FreeGroup XY →* Sym n := FreeGroup.lift (xyv n (by omega)) with hφ
  have hsurj : Function.Surjective φ := by
    rw [← MonoidHom.range_eq_top, eq_top_iff, ← closure_xs_ys hn, Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · exact ⟨FreeGroup.of .x, FreeGroup.lift_apply_of⟩
    · exact ⟨FreeGroup.of .y, FreeGroup.lift_apply_of⟩
  set K := φ.ker with hK
  haveI : Group.FG (FreeGroup XY) :=
    Group.fg_iff.mpr ⟨Set.range FreeGroup.of, FreeGroup.closure_range_of _, Set.finite_range _⟩
  haveI : K.FiniteIndex := Subgroup.finiteIndex_ker φ
  haveI : Group.FG K := Subgroup.fg_of_index_ne_zero K
  obtain ⟨S, hS⟩ := (inferInstance : Group.FG K).out
  set S' : Finset (FreeGroup XY) := S.image Subtype.val with hS'
  have hNC : Subgroup.normalClosure (S' : Set (FreeGroup XY)) = K := by
    apply le_antisymm
    · apply Subgroup.normalClosure_le_normal
      intro w hw
      rw [hS', Finset.coe_image] at hw
      obtain ⟨k, -, rfl⟩ := hw
      exact k.2
    · have : K = Subgroup.map K.subtype (Subgroup.closure (S : Set K)) := by
        rw [hS, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
      rw [this, MonoidHom.map_closure]
      refine le_trans ?_ (Subgroup.closure_le_normalClosure)
      apply Subgroup.closure_mono
      rw [hS', Finset.coe_image]
      rfl
  set R : Finset (PE XY) := S'.image (fun w => wordPE (FreeGroup.toWord w)) with hR
  have hRS : PE.toFreeGroup '' (R : Set (PE XY)) = (S' : Set (FreeGroup XY)) := by
    rw [hR, Finset.coe_image, Set.image_image]
    have e : (fun w : FreeGroup XY => (wordPE (FreeGroup.toWord w)).toFreeGroup) = id := by
      funext w; rw [toFreeGroup_wordPE, FreeGroup.mk_toWord]; rfl
    rw [e, Set.image_id]
  have hP : IsPresentation (xyv n (by omega)) (R : Set (PE XY)) := by
    have hrel : ∀ r ∈ PE.toFreeGroup '' (R : Set (PE XY)), FreeGroup.lift (xyv n (by omega)) r = 1 := by
      rw [hRS]
      intro r hr
      have : r ∈ K := by rw [← hNC]; exact Subgroup.subset_normalClosure hr
      exact this
    refine ⟨hrel, ?_, ?_⟩
    · rw [← MonoidHom.ker_eq_bot_iff, PresentedGroup.toGroup, QuotientGroup.ker_lift]
      rw [hRS, show (FreeGroup.lift (xyv n (by omega))).ker =
        Subgroup.normalClosure (↑S' : Set (FreeGroup XY)) from hNC.symm]
      exact QuotientGroup.map_mk'_self _
    · exact QuotientGroup.lift_surjective_of_surjective _ _ hsurj _
  -- normalise
  have e : {E | E ∈ R.toList} = (R : Set (PE XY)) := by ext E; simp
  have hP' := isPresentation_normalize R.toList (by rw [e]; exact hP)
  refine ⟨(R.toList.filterMap PE.normalize).toFinset, ?_, ?_⟩
  · rwa [List.coe_toFinset]
  · intro E hE
    obtain ⟨F, _, hF⟩ := List.mem_filterMap.mp (List.mem_toFinset.mp hE)
    exact ((normalize_spec F).2 E hF).1

/-! ### The main theorem -/

/-- **Theorem 1.1.** There are absolute constants `r₀`, `c₀` such that for every `n ≥ 2` the
symmetric group `S_n` has a presentation on `x = (0,1)`, `y = (0,1,…,n-1)` with at most `r₀`
relators (genuine power expressions) and length at most `c₀ log₂ n`. -/
theorem main_theorem : ∃ r₀ c₀ : ℕ, ∀ n (hn : 2 ≤ n), ∃ R : Finset (PE XY),
    IsPresentation (xyv n (by omega)) (R : Set (PE XY)) ∧ (∀ E ∈ R, E.WF) ∧
      R.card ≤ r₀ ∧ presLength R ≤ c₀ * Nat.log 2 n := by
  classical
  -- small `n`
  let pick : ℕ → Finset (PE XY) := fun n =>
    if h : 2 ≤ n then Classical.choose (exists_finite_presentation n h) else ∅
  have hpick : ∀ n (h : 2 ≤ n), IsPresentation (xyv n (by omega)) (pick n : Set (PE XY)) ∧
      ∀ E ∈ pick n, E.WF := by
    intro n h
    simp only [pick, dif_pos h]
    exact Classical.choose_spec (exists_finite_presentation n h)
  let r1 := (Finset.range 245).sup (fun n => (pick n).card)
  let c1 := (Finset.range 245).sup (fun n => presLength (pick n))
  refine ⟨max 62 r1, max cLarge c1, ?_⟩
  intro n hn
  by_cases hbig : 245 ≤ n
  · obtain ⟨R, hP, hW, hc, hl⟩ := main_large' n hbig
    exact ⟨R, hP, hW, hc.trans (le_max_left _ _),
      hl.trans (Nat.mul_le_mul_right _ (le_max_left _ _))⟩
  · have hmem : n ∈ Finset.range 245 := Finset.mem_range.mpr (by omega)
    obtain ⟨hP, hW⟩ := hpick n hn
    refine ⟨pick n, hP, hW, ?_, ?_⟩
    · exact (Finset.le_sup (f := fun n => (pick n).card) hmem).trans (le_max_right _ _)
    · have hlog : 1 ≤ Nat.log 2 n := Nat.le_log_of_pow_le (by norm_num) (by omega)
      calc presLength (pick n) ≤ c1 := Finset.le_sup (f := fun n => presLength (pick n)) hmem
        _ ≤ max cLarge c1 := le_max_right _ _
        _ = max cLarge c1 * 1 := (mul_one _).symm
        _ ≤ max cLarge c1 * Nat.log 2 n := Nat.mul_le_mul_left _ hlog

/-- **Theorem 1.1, second part**: for `n ≥ 245` one can take `r₀ = 62`. -/
theorem main_theorem_62 : ∃ c₀ : ℕ, ∀ n (hn : 245 ≤ n), ∃ R : Finset (PE XY),
    IsPresentation (xyv n (by omega)) (R : Set (PE XY)) ∧ (∀ E ∈ R, E.WF) ∧
      R.card ≤ 62 ∧ presLength R ≤ c₀ * Nat.log 2 n :=
  ⟨cLarge, main_large'⟩

end SnPres
